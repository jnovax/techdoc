<%- include('../build/cover-pack-header') %>
<link rel="stylesheet" href="<%- serverURL %>/css/docusaurus-theme.css?v=20260909_widescreen_v6">
<link rel="stylesheet" href="<%- serverURL %>/css/portal.css">
<script nonce="<%- cspNonce %>">
    (function() {
        var theme = localStorage.getItem('theme') || (localStorage.getItem('nightMode') === 'true' ? 'dark' : null);
        if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
        }
        if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            document.documentElement.classList.add('night');
        } else {
            document.documentElement.setAttribute('data-theme', 'light');
        }
    })();
</script>

