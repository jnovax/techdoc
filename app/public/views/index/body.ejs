<style>
.btn-trash-action {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 15px;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
}
.btn-trash-action:hover {
    background: #fee2e2;
    color: #e11d48;
}
.note-card-trash {
    border-left: 4px solid #f43f5e !important;
    background: #fffafa !important;
    cursor: default;
}
.note-card-trash:hover {
    transform: none !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05) !important;
}
.badge-trash {
    background: #fee2e2 !important;
    color: #dc2626 !important;
}
.portal-tab-btn.tab-trash {
    color: #e11d48;
}
.portal-tab-btn.tab-trash.active {
    background: #ffe4e6 !important;
    color: #be123c !important;
}
.portal-tab-btn.tab-trash:hover {
    background: #fff1f2 !important;
    color: #9f1239 !important;
}
</style>

<div class="portal-wrapper" data-server-url="<%- serverURL %>">
    <header class="portal-navbar">
        <a href="<%- serverURL %>/" class="portal-brand">
            <img src="<%- serverURL %>/banner/banner_vertical_color.svg" alt="TechDoc">
            <span>TechDoc</span>
        </a>

        <div class="portal-search-bar">
            <i class="fa fa-search portal-search-icon"></i>
            <input type="text" id="portalSearch" class="portal-search-input" placeholder="Tìm kiếm tài liệu theo tiêu đề...">
        </div>

        <div class="portal-actions">
            <% if (!signin) { %>
                <% if (allowAnonymous && !disableNoteCreation) { %>
                    <a href="<%- serverURL %>/new" class="portal-btn portal-btn-outline">
                        <i class="fa fa-plus"></i> <span class="hidden-xs">Ghi chú khách</span>
                    </a>
                <% } %>
                <a href="<%- serverURL %>/login" class="portal-btn portal-btn-primary">
                    <i class="fa fa-sign-in"></i> Đăng nhập
                </a>
            <% } else { %>
                <% if (!disableNoteCreation) { %>
                    <a href="<%- serverURL %>/new" class="portal-btn portal-btn-success">
                        <i class="fa fa-plus"></i> Tạo ghi chú mới
                    </a>
                <% } %>
                <span class="dropdown">
                    <button class="portal-btn portal-btn-outline dropdown-toggle" type="button" id="userMenuBtn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-user-circle"></i> <span class="hidden-xs">Tài khoản</span> <i class="fa fa-caret-down"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="userMenuBtn">
                        <li><a href="<%- serverURL %>/me/export"><i class="fa fa-cloud-download fa-fw"></i> <%= __('Export user data') %></a></li>
                        <li><a class="ui-delete-user" href="#" data-toggle="modal" data-target=".delete-user-modal"><i class="fa fa-trash fa-fw"></i> <%= __('Delete user') %></a></li>
                        <li role="separator" class="divider"></li>
                        <li><a href="<%- serverURL %>/logout"><i class="fa fa-sign-out fa-fw"></i> <%= __('Sign Out') %></a></li>
                    </ul>
                </span>
            <% } %>
        </div>
    </header>

    <% if (infoMessage && infoMessage.length > 0) { %>
        <div style="max-width: 1240px; margin: 16px auto 0; padding: 0 24px;">
            <div class="alert alert-info"><%= infoMessage %></div>
        </div>
    <% } %>
    <% if (errorMessage && errorMessage.length > 0) { %>
        <div style="max-width: 1240px; margin: 16px auto 0; padding: 0 24px;">
            <div class="alert alert-danger"><%= errorMessage %></div>
        </div>
    <% } %>

    <main class="portal-container">
        <div class="portal-header">
            <h1 class="portal-heading">Kho Tri Thức & Ghi Chú</h1>
            <p class="portal-subheading">Xem, tìm kiếm và cộng tác các tài liệu Markdown trong hệ thống</p>
        </div>

        <div class="portal-tabs">
            <button class="portal-tab-btn active" data-filter="all">Tất cả (<span id="allCount"><%= (notes || []).length %></span>)</button>
            <button class="portal-tab-btn" data-filter="public">Công khai</button>
            <% if (signin) { %>
                <button class="portal-tab-btn" data-filter="protected">Nội bộ (Protected)</button>
                <button class="portal-tab-btn" data-filter="mine">Của tôi & Bản nháp</button>
                <button class="portal-tab-btn tab-trash" data-filter="trash">
                    <i class="fa fa-trash-o"></i> Thùng rác (<span id="trashCount"><%= (trashedNotes || []).length %></span>)
                </button>
            <% } %>
        </div>

        <div class="portal-grid" id="notesGrid">
            <div class="portal-empty" id="emptyNotice" style="<%= (!notes || notes.length === 0) && (!trashedNotes || trashedNotes.length === 0) ? 'display: block;' : 'display: none;' %>">
                <i class="fa fa-folder-open-o fa-3x" id="emptyNoticeIcon"></i>
                <h3 id="emptyNoticeTitle">Chưa có tài liệu nào</h3>
                <p id="emptyNoticeDesc">Hiện chưa có ghi chú nào phù hợp với quyền truy cập của bạn.</p>
            </div>

            <% if (notes && notes.length > 0) { %>
                <% notes.forEach(function(note) { 
                    var badgeClass = 'public';
                    var badgeLabel = 'Công khai';
                    var filterType = 'public';
                    if (note.permission === 'protected' || note.permission === 'limited') {
                        badgeClass = 'protected';
                        badgeLabel = 'Nội bộ';
                        filterType = 'protected';
                    } else if (note.permission === 'private') {
                        badgeClass = 'private';
                        badgeLabel = 'Bản nháp / Riêng tư';
                        filterType = 'private';
                    }
                %>
                    <a href="<%- serverURL %>/<%- note.id %>" class="note-card" data-filter="<%- filterType %>" data-mine="<%- note.isOwner ? 'true' : 'false' %>" data-title="<%- (note.title || '').toLowerCase() %>" data-id="<%- note.id %>" data-permission="<%- note.permission %>" data-snippet="<%= note.snippet %>" data-author="<%= note.authorName %>" data-viewcount="<%= note.viewcount %>">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <span class="note-badge <%- badgeClass %>">
                                    <% if (badgeClass === 'public') { %><i class="fa fa-globe"></i><% } %>
                                    <% if (badgeClass === 'protected') { %><i class="fa fa-lock"></i><% } %>
                                    <% if (badgeClass === 'private') { %><i class="fa fa-user-secret"></i><% } %>
                                    <%- badgeLabel %>
                                </span>
                                <% if (note.isOwner) { %>
                                    <button type="button" class="btn-trash-action" data-note-id="<%- note.id %>" data-note-title="<%- note.title %>" title="Chuyển vào thùng rác">
                                        <i class="fa fa-trash-o"></i>
                                    </button>
                                <% } %>
                            </div>
                            <h2 class="note-title"><%= note.title %></h2>
                            <p class="note-snippet"><%= note.snippet %></p>
                        </div>
                        <div class="note-footer">
                            <div class="note-author">
                                <i class="fa fa-user-circle"></i>
                                <span><%= note.authorName %></span>
                            </div>
                            <div>
                                <i class="fa fa-eye"></i> <%- note.viewcount %> lượt xem
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } %>

            <% if (signin && trashedNotes && trashedNotes.length > 0) { %>
                <% trashedNotes.forEach(function(tNote) { 
                    var tSnippet = tNote.snippet || 'Không có nội dung mô tả';
                %>
                    <div class="note-card note-card-trash" data-filter="trash" data-mine="true" data-id="<%- tNote.id %>" data-title="<%- (tNote.title || '').toLowerCase() %>" data-permission="<%- tNote.permission || 'freely' %>" data-snippet="<%= tSnippet %>" data-viewcount="<%= tNote.viewcount || 0 %>" style="display: none;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <span class="note-badge badge-trash">
                                    <i class="fa fa-trash"></i> Đã xóa
                                </span>
                            </div>
                            <h2 class="note-title" style="color: #64748b; text-decoration: line-through;"><%= tNote.title || 'Ghi chú không tiêu đề' %></h2>
                            <p class="note-snippet"><%= tSnippet %></p>
                        </div>
                        <div class="note-footer" style="margin-top: 16px; display: flex; justify-content: space-between; align-items: center;">
                            <div style="font-size: 12px; color: #94a3b8;">
                                <i class="fa fa-clock-o"></i> <%= tNote.deletedAt ? new Date(tNote.deletedAt).toLocaleDateString('vi-VN') : '' %>
                            </div>
                            <div class="note-trash-actions" style="display: flex; gap: 8px;">
                                <button type="button" class="btn btn-sm btn-outline-primary btn-restore-action" data-note-id="<%- tNote.id %>" data-note-title="<%- tNote.title || '' %>" title="Khôi phục ghi chú" style="font-size: 12px; padding: 4px 10px; border: 1px solid #3b82f6; color: #2563eb; background: #eff6ff; border-radius: 4px; cursor: pointer;">
                                    <i class="fa fa-undo"></i> Khôi phục
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-force-delete-action" data-note-id="<%- tNote.id %>" data-note-title="<%- tNote.title || '' %>" title="Xóa vĩnh viễn" style="font-size: 12px; padding: 4px 10px; border: 1px solid #ef4444; color: #dc2626; background: #fef2f2; border-radius: 4px; cursor: pointer;">
                                    <i class="fa fa-trash"></i> Xóa vĩnh viễn
                                </button>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </main>

    <footer class="mastfoot" style="width: 100%; margin-top: auto; background: #ffffff; border-top: 1px solid #e2e8f0; padding: 24px 0; text-align: center; color: #64748b; font-size: 13px;">
        <div class="inner" style="width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px;">
            <p style="margin: 0; font-weight: 500;">
                © 2026 TechDoc · Nền tảng ghi chú &amp; tài liệu kỹ thuật
            </p>
        </div>
    </footer>
</div>

<!-- delete user modal -->
<div class="modal fade delete-user-modal" tabindex="-1" role="dialog" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="deleteUserModalLabel"><%= __('Are you sure?') %></h4>
            </div>
            <div class="modal-body">
                <h5><%= __('Do you really want to delete your user account?') %></h5>
                <strong><%= __('This will delete your account, all notes that are owned by you and remove all references to your account from other notes.') %></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><%= __('Cancel') %></button>
                <a type="button" class="btn btn-danger" href="<%- serverURL %>/me/delete/<%- deleteToken %>"><%= __('Yes, do it!') %></a>
            </div>
        </div>
    </div>
</div>

<!-- soft delete confirm modal -->
<div class="modal fade trash-confirm-modal" tabindex="-1" role="dialog" aria-labelledby="trashModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trashModalLabel"><i class="fa fa-trash-o text-warning"></i> Chuyển vào thùng rác?</h4>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn chuyển tài liệu <strong id="trashModalNoteTitle"></strong> vào thùng rác?</p>
                <small class="text-muted">Bạn có thể khôi phục lại tài liệu này bất cứ lúc nào trong tab Thùng rác.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning" id="trashModalConfirmBtn">Chuyển vào thùng rác</button>
            </div>
        </div>
    </div>
</div>

<!-- force delete danger modal -->
<div class="modal fade force-delete-modal" tabindex="-1" role="dialog" aria-labelledby="forceDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="border-top: 4px solid #dc2626;">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="forceDeleteModalLabel" style="color: #dc2626;"><i class="fa fa-exclamation-triangle"></i> Xóa vĩnh viễn?</h4>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa vĩnh viễn tài liệu <strong id="forceDeleteModalNoteTitle"></strong> không?</p>
                <div class="alert alert-danger" style="margin-bottom: 0; padding: 8px 12px; font-size: 13px;">
                    <strong>Cảnh báo:</strong> Hành động này <u>KHÔNG THỂ HOÀN TÁC</u>. Mọi lịch sử sửa đổi và nội dung sẽ bị xóa hoàn toàn khỏi cơ sở dữ liệu.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="forceDeleteModalConfirmBtn">Xác nhận xóa vĩnh viễn</button>
            </div>
        </div>
    </div>
</div>

<%- include('../shared/signin-modal') %>

<script src="<%- serverURL %>/js/portal.js?v=20260909_2" defer></script>

