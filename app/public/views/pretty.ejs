<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="mobile-web-app-capable" content="yes">
    <% if(typeof robots !== 'undefined' && robots) { %>
    <meta name="robots" content="<%= robots %>">
    <% } %>
    <% if(typeof description !== 'undefined' && description) { %>
    <meta name="description" content="<%= description %>">
    <% } %>
    <% for (var og in opengraph) { %>
    <% if (Object.keys(opengraph).includes(og) && typeof opengraph[og] === 'string' && opengraph[og].trim() !== '') { %>
    <meta property="og:<%= og %>" content="<%= opengraph[og] %>">
    <% }} if (!Object.keys(opengraph).includes('image')) { %>
    <meta property="og:image" content="<%- serverURL %>/icons/android-chrome-512x512.png">
    <meta property="og:image:alt" content="TechDoc logo">
    <meta property="og:image:type" content="image/png">
    <% } %>
    <base href="<%- serverURL %>/">
    <title><%= title %></title>
    <%- include('includes/favicon.ejs') %>
    <link rel="stylesheet" href='<%- serverURL %>/build/emojify.js/dist/css/basic/emojify.min.css'>
    <%- include('build/pretty-pack-header') %>
    <link rel="stylesheet" href="<%- serverURL %>/css/inpage-search.css">
    <link rel="stylesheet" href="<%- serverURL %>/css/docusaurus-theme.css?v=20260910_slide_v1">
    <script nonce="<%- cspNonce %>">
        (function() {
            var theme = localStorage.getItem('theme') || (localStorage.getItem('nightMode') === 'true' ? 'dark' : null);
            if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                theme = 'dark';
            }
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
                document.documentElement.classList.add('night');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>

<body class="docusaurus-layout" style="display:none;">
    <!-- Docusaurus Modern Sticky Navbar -->
    <header class="docusaurus-navbar">
        <div class="docusaurus-navbar-left">
            <a href="<%- serverURL %>/" class="portal-brand docusaurus-navbar-brand" title="TechDoc">
                <img src="<%- serverURL %>/banner/banner_h_bw.svg" alt="TechDoc">
            </a>
            <span class="docusaurus-navbar-separator">/</span>
            <span class="docusaurus-navbar-title"><%= title.replace(/ - TechDoc$/, '') %></span>
        </div>

        <div class="docusaurus-navbar-right">
            <div class="techdoc-navbar-search" id="techdocNavbarSearch">
                <i class="fa fa-search techdoc-navbar-search-icon"></i>
                <input type="text" class="techdoc-navbar-search-input" placeholder="Tìm trong bài..." aria-label="Tìm kiếm trong tài liệu">
                <span class="techdoc-navbar-search-counter" style="display: none;"></span>
                <div class="techdoc-navbar-search-nav" style="display: none;">
                    <button type="button" class="techdoc-navbar-search-btn search-prev-btn" title="Kết quả trước (Shift+Enter)"><i class="fa fa-chevron-up"></i></button>
                    <button type="button" class="techdoc-navbar-search-btn search-next-btn" title="Kết quả tiếp theo (Enter)"><i class="fa fa-chevron-down"></i></button>
                    <button type="button" class="techdoc-navbar-search-btn search-clear-btn" title="Xóa tìm kiếm (Esc)"><i class="fa fa-times"></i></button>
                </div>
                <kbd class="techdoc-navbar-search-kbd hidden-xs">Ctrl F</kbd>
            </div>
            <span class="docusaurus-view-badge hidden-xs">
                <i class="fa fa-eye"></i> <%- viewcount %> lượt xem
            </span>
            <button type="button" class="docusaurus-theme-toggle" id="docusaurusThemeToggle" title="Chuyển đổi giao diện sáng/tối" aria-label="Chuyển đổi giao diện sáng/tối">
                <i class="fa fa-sun-o theme-icon-light" aria-hidden="true"></i>
                <i class="fa fa-moon-o theme-icon-dark" aria-hidden="true"></i>
            </button>
            <a href="<%- serverURL %>/" class="docusaurus-flat-btn docusaurus-flat-btn-default" title="Quay lại danh sách ghi chú">
                <i class="fa fa-arrow-left"></i> <span class="hidden-xs">Trang chủ</span>
            </a>
            <a href="#" class="docusaurus-flat-btn docusaurus-flat-btn-primary ui-edit" title="Chỉnh sửa tài liệu">
                <i class="fa fa-pencil"></i> <span class="hidden-xs">Chỉnh sửa</span>
            </a>
            <% if (typeof noteId !== 'undefined' && noteId && typeof isSlide !== 'undefined' && isSlide) { %>
            <a href="<%- serverURL %>/p/<%- noteId %>" class="docusaurus-flat-btn docusaurus-flat-btn-default ui-slide" id="techdocSlideBtn" title="Trình chiếu toàn màn hình (Slide Mode)" target="_blank" rel="noopener">
                <i class="fa fa-tv"></i> <span class="hidden-xs">Trình chiếu</span>
            </a>
            <% } %>
            <% if (typeof isOwner !== 'undefined' && isOwner) { %>
            <button type="button" class="docusaurus-flat-btn docusaurus-flat-btn-danger ui-trash" title="Chuyển tài liệu vào thùng rác">
                <i class="fa fa-trash-o"></i> <span class="hidden-xs">Chuyển vào thùng rác</span>
            </button>
            <% } %>
        </div>
    </header>

    <!-- Main Container: Clean Reading Column + Sticky TOC Sidebar -->
    <div class="docusaurus-layout-wrapper docusaurus-container">
        <!-- Main Content Column -->
        <main class="docusaurus-main-content">
            <!-- Document Hero Header -->
            <div class="doc-hero-header">
                <h1 class="doc-hero-title"><%= title.replace(/ - TechDoc$/, '') %></h1>
                <div class="doc-hero-meta">
                    <span class="meta-item meta-updated">
                        <i class="fa fa-clock-o"></i> Cập nhật: <span class="ui-updated-text"><%- updatetime ? (new Date(updatetime)).toLocaleDateString() : 'Gần đây' %></span>
                    </span>
                    <span class="meta-item meta-views">
                        <i class="fa fa-eye"></i> <%- viewcount %> lượt xem
                    </span>
                </div>
            </div>

            <div id="doc" class="markdown-body" <% if (lang) { %> lang="<%= lang %>"<% } %>><%= body %></div>
            <% if(typeof disqus !== 'undefined' && disqus && !dnt) { %>
            <div style="margin-top: 50px;">
                <%- include('shared/disqus') %>
            </div>
            <% } %>
        </main>

        <!-- Right Sticky TOC Sidebar -->
        <aside id="docusaurusToc" class="docusaurus-toc-sidebar"></aside>
    </div>

    <!-- Hidden compatibility elements for pretty-pack-scripts -->
    <span class="ui-lastchange" style="display:none;" data-createtime="<%- createtime %>" data-updatetime="<%- updatetime %>"></span>
    <div class="ui-toc" style="display:none;"></div>
    <!-- Trash Confirm Modal -->
    <div class="modal fade pretty-trash-modal" tabindex="-1" role="dialog" aria-labelledby="prettyTrashModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="prettyTrashModalLabel"><i class="fa fa-trash-o text-danger"></i> Chuyển vào thùng rác?</h4>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc chắn muốn chuyển tài liệu này vào thùng rác không?</p>
                    <small class="text-muted">Bạn có thể khôi phục lại tài liệu trong tab Thùng rác trên trang chủ.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="docusaurus-flat-btn docusaurus-flat-btn-default" data-dismiss="modal">Hủy</button>
                    <button type="button" class="docusaurus-flat-btn docusaurus-flat-btn-danger" id="prettyTrashConfirmBtn">Chuyển vào thùng rác</button>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
<script src="<%= serverURL %>/js/mathjax-config-extra.js"></script>
<script src="<%- serverURL %>/build/MathJax/MathJax.js" defer></script>
<script src="<%- serverURL %>/build/MathJax/config/TeX-AMS-MML_HTMLorMML.js" defer></script>
<script src="<%- serverURL %>/build/MathJax/config/Safe.js" defer></script>
<%- include('build/pretty-pack-scripts') %>
<script src="<%- serverURL %>/js/inpage-search.js" defer></script>
<script src="<%- serverURL %>/js/theme-switcher.js" defer></script>
<script src="<%- serverURL %>/js/docusaurus-toc.js?v=20260909_clean_v5" defer></script>
<script src="<%- serverURL %>/js/pretty-trash.js?v=20260909_1" defer></script>
<%- include('shared/ga') %>
