<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="mobile-web-app-capable" content="yes">
<%- include('../includes/favicon') %>
<% for (var og in opengraph) { %>
<% if (Object.keys(opengraph).includes(og) && typeof opengraph[og] === 'string' && opengraph[og].trim() !== '') { %>
<meta property="og:<%= og %>" content="<%= String(opengraph[og]) %>">
<% }} if (!Object.keys(opengraph).includes('image')) { %>
<meta property="og:image" content="<%- serverURL %>/icons/android-chrome-512x512.png">
<meta property="og:image:alt" content="TechDoc logo">
<meta property="og:image:type" content="image/png">
<% } %>
<base href="<%- serverURL %>/">
<title><%= title %></title>
<link rel="stylesheet" href='<%- serverURL %>/build/emojify.js/dist/css/basic/emojify.min.css'>
<%- include('../build/index-pack-header') %>
<link rel="stylesheet" href="<%- serverURL %>/css/inpage-search.css">
<link rel="stylesheet" href="<%- serverURL %>/css/docusaurus-theme.css?v=20260909_widescreen_v4">
<link rel="stylesheet" href="<%- serverURL %>/css/hackmd-neo.css?v=20260911_v1">
<script nonce="<%- cspNonce %>">
    (function() {
        var theme = localStorage.getItem('theme') || (localStorage.getItem('nightMode') === 'true' ? 'dark' : null);
        if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
        }
        if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            document.documentElement.classList.add('night');
        } else {
            document.documentElement.setAttribute('data-theme', 'light');
        }
    })();
</script>

